# Browser-safe values. Configure production values in Vercel Project Settings.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Configure CRON_SECRET and SUPABASE_SERVICE_ROLE_KEY in Vercel only.
# Never add server-only secrets to this file or expose them with NEXT_PUBLIC_ names.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
