# Browser-safe values. Configure production values in Vercel Project Settings.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Non-sensitive server configuration selectors. Set server-only keys only in
# Vercel Project Settings; never add them to this file or use NEXT_PUBLIC_.
AI_PROVIDER=deepseek
DEEPSEEK_MODEL=deepseek-chat
EMBEDDING_PROVIDER=mock
